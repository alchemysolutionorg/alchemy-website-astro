---
import TechGrid from '../islands/TechGrid';

interface TechItem {
  name: string;
  color: string;
  category: "ai" | "frontend" | "backend" | "devops" | "database";
  featured?: boolean;
}

interface AITool {
  name: string;
  tag: string;
  desc: string;
  border: string;
  accent: string;
}

interface Props {
  data?: {
    sectionTitle?: string;
    sectionSubtitle?: string;
    aiTools?: AITool[];
    techStack?: TechItem[];
    rhcsaCertified?: boolean;
  };
}

const categoryStyles = {
  ai: { color: "#a855f7", glow: "rgba(168,85,247,0.25)", label: "AI / ML" },
  frontend: { color: "#60a5fa", glow: "rgba(96,165,250,0.22)", label: "Frontend" },
  backend: { color: "#34d399", glow: "rgba(52,211,153,0.22)", label: "Backend" },
  devops: { color: "#fb923c", glow: "rgba(251,146,60,0.22)", label: "DevOps" },
  database: { color: "#facc15", glow: "rgba(250,204,21,0.22)", label: "Database" },
};

const defaultAITools = [
  { name: "Claude Code", tag: "Agentic AI", border: "border-violet-500/30", accent: "from-violet-500/20", desc: "Complex refactors, architecture reviews, and automated codebase navigation." },
  { name: "Cursor IDE", tag: "AI Pair Coding", border: "border-blue-400/30", accent: "from-blue-500/20", desc: "AI-first development environment for continuous code generation and live debugging." },
  { name: "Opus 4.6", tag: "Foundation Model", border: "border-purple-400/30", accent: "from-purple-500/20", desc: "Architectural reasoning, complex prompt engineering, and AI agent backends." },
  { name: "Claude Sonnet", tag: "Speed + Power", border: "border-indigo-400/30", accent: "from-indigo-500/20", desc: "Balanced intelligence and speed for API chains and real-time assistant features." },
  { name: "GLM 5.1", tag: "Multilingual LLM", border: "border-emerald-400/30", accent: "from-emerald-500/20", desc: "Cross-language projects and specialized NLP workflows." },
];

const defaultTechStack: TechItem[] = [
  // AI / ML
  { name: "Claude", color: "#cc785c", category: "ai", featured: true },
  { name: "MCP", color: "#06b6d4", category: "ai", featured: true },
  { name: "Multi-Agent", color: "#a855f7", category: "ai", featured: true },
  { name: "LangChain", color: "#65c179", category: "ai", featured: true },
  { name: "OpenAI", color: "#74aa9c", category: "ai" },
  { name: "Anthropic", color: "#cc785c", category: "ai" },
  { name: "Mistral AI", color: "#ff7000", category: "ai" },
  { name: "Hugging Face", color: "#ffbd13", category: "ai" },
  { name: "Ollama", color: "#e0e0e0", category: "ai" },
  { name: "Replicate", color: "#a855f7", category: "ai" },
  // Frontend
  { name: "React.js", color: "#61dafb", category: "frontend" },
  { name: "Next.js", color: "#e0e0e0", category: "frontend" },
  { name: "TypeScript", color: "#3178c6", category: "frontend" },
  { name: "Tailwind CSS", color: "#06b6d4", category: "frontend" },
  { name: "Vite", color: "#646cff", category: "frontend" },
  { name: "SvelteKit", color: "#ff3e00", category: "frontend" },
  { name: "Astro.js", color: "#ff5d01", category: "frontend" },
  { name: "Framer Motion", color: "#0055ff", category: "frontend" },
  { name: "Vercel", color: "#e0e0e0", category: "frontend" },
  // Backend
  { name: "Java", color: "#f89820", category: "backend" },
  { name: "Spring Boot", color: "#6db33f", category: "backend" },
  { name: "Go", color: "#00add8", category: "backend" },
  { name: "Python", color: "#3776ab", category: "backend" },
  { name: "FastAPI", color: "#009688", category: "backend" },
  { name: "Django", color: "#44b78b", category: "backend" },
  { name: "Node.js", color: "#339933", category: "backend" },
  { name: "NestJS", color: "#e0234e", category: "backend" },
  { name: "Express", color: "#c0c0c0", category: "backend" },
  { name: "Rust", color: "#ce412b", category: "backend" },
  // DevOps
  { name: "Docker", color: "#2496ed", category: "devops" },
  { name: "Kubernetes", color: "#326ce5", category: "devops" },
  { name: "Terraform", color: "#7b42bc", category: "devops" },
  { name: "Ansible", color: "#ee0000", category: "devops" },
  { name: "Red Hat", color: "#ee0000", category: "devops" },
  { name: "GitHub Actions", color: "#2088ff", category: "devops" },
  { name: "Jenkins", color: "#d33833", category: "devops" },
  { name: "Prometheus", color: "#e6522c", category: "devops" },
  { name: "Grafana", color: "#f46800", category: "devops" },
  { name: "Linux", color: "#fcc624", category: "devops" },
  // Database
  { name: "PostgreSQL", color: "#336791", category: "database" },
  { name: "MongoDB", color: "#4db33d", category: "database" },
  { name: "Redis", color: "#dc382d", category: "database" },
  { name: "MySQL", color: "#4479a1", category: "database" },
];

const { data } = Astro.props as Props;
const aiTools = data?.aiTools || defaultAITools;
const techStack = data?.techStack || defaultTechStack;
---

<section id="engineering" class="py-32 relative">
  <!-- Background glows -->
  <div class="absolute top-1/4 left-1/4 w-[600px] h-[300px] bg-violet-500/5 rounded-full blur-[140px] pointer-events-none" />
  <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[300px] bg-blue-500/5 rounded-full blur-[140px] pointer-events-none" />

  <div class="container mx-auto px-6 relative z-10">

    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-4 reveal-item">
        Engineering Culture
      </p>
      <h2 class="text-4xl md:text-5xl font-display font-bold mb-6 reveal-item">
        Built by <span class="text-gradient">Masters of the Craft</span>
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto reveal-item">
        {data?.sectionSubtitle || "We don't just use the latest tools — we integrate them into our DNA. AI-augmented development, certified infrastructure engineers, and deep mastery across the full modern stack."}
      </p>
    </div>

    <!-- AI Tools spotlight -->
    <div class="mb-20 reveal-section">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
            <path d="M12 8V4H8"/>
            <rect width="16" height="12" x="4" y="8" rx="2"/>
            <path d="M2 14h2"/>
            <path d="M20 14h2"/>
            <path d="M15 13v2"/>
            <path d="M9 13v2"/>
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold font-display">AI-Augmented Development</h3>
          <p class="text-sm text-muted-foreground">We work alongside cutting-edge AI to build faster and smarter</p>
        </div>
        <span class="ml-auto px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 border border-primary/30 text-primary hidden sm:inline-flex items-center gap-1.5 animate-pulse">
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
          Active in every sprint
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
        {aiTools.map((tool, i) => (
          <div
            class={`glass-card border ${tool.border} rounded-2xl p-5 relative overflow-hidden group cursor-default ai-tool-card`}
            style={`transition-delay: ${i * 0.08}s`}
          >
            <div class={`absolute inset-0 bg-gradient-to-br ${tool.accent} to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl`} />
            <div class="relative z-10">
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-foreground/5 border border-white/10 text-muted-foreground mb-3 inline-block">
                {tool.tag}
              </span>
              <h4 class="font-bold text-base font-display mb-2">{tool.name}</h4>
              <p class="text-xs text-muted-foreground leading-relaxed">{tool.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- RHCSA certification -->
    <div class="mb-20 glass-card border border-emerald-400/30 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4 relative overflow-hidden reveal-section">
      <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/10 to-transparent pointer-events-none rounded-2xl" />
      <div class="relative z-10 w-14 h-14 rounded-2xl bg-emerald-400/10 border border-emerald-400/30 flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400">
          <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div class="relative z-10 flex-1">
        <div class="flex flex-wrap items-center gap-2 mb-1">
          <h4 class="font-bold text-lg font-display">Red Hat Certified System Administrators</h4>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-400/15 border border-emerald-400/40 text-emerald-400 tracking-wide">
            RHCSA Certified
          </span>
        </div>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Our infrastructure team holds active <strong class="text-foreground">RHCSA</strong> certifications —
          enterprise-grade Linux expertise from hardened production deployments to SELinux policies,
          systemd service management, and kernel-level network configuration.
        </p>
      </div>
      <div class="relative z-10 hidden lg:flex flex-col items-center gap-1 flex-shrink-0">
        <div class="text-3xl font-black font-display text-emerald-400">RHCSA</div>
        <div class="text-xs text-muted-foreground tracking-widest uppercase">Red Hat</div>
      </div>
    </div>

    <!-- Tech Stack Wall -->
    <div class="reveal-section">
      <!-- Section label -->
      <div class="flex flex-col items-center gap-4 mb-10">
        <h3 class="text-2xl md:text-3xl font-bold font-display text-center">
          The Full <span class="text-gradient">Technology Arsenal</span>
        </h3>
        <p class="text-sm text-muted-foreground text-center">Every layer of the modern stack, mastered</p>

        <!-- Category legend -->
        <div class="flex flex-wrap items-center justify-center gap-4 mt-1">
          {Object.entries(categoryStyles).map(([key, val]) => (
            <div class="flex items-center gap-1.5">
              <div class="w-2 h-2 rounded-full" style={`background: ${val.color}`} />
              <span class="text-xs text-muted-foreground font-medium">{val.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Background container with subtle depth -->
      <div class="relative rounded-3xl overflow-hidden">
        <!-- Multi-color glow blobs in background -->
        <div class="absolute top-8 left-16 w-48 h-48 rounded-full opacity-20 blur-[60px] pointer-events-none" style="background: #a855f7" />
        <div class="absolute top-4 right-24 w-36 h-36 rounded-full opacity-15 blur-[50px] pointer-events-none" style="background: #60a5fa" />
        <div class="absolute bottom-12 left-1/3 w-40 h-40 rounded-full opacity-12 blur-[55px] pointer-events-none" style="background: #34d399" />
        <div class="absolute bottom-4 right-16 w-44 h-44 rounded-full opacity-15 blur-[60px] pointer-events-none" style="background: #fb923c" />

        <!-- Outer glass container -->
        <div class="relative glass-card border border-white/8 rounded-3xl p-5">
          <TechGrid client:visible techStack={techStack} />
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .reveal-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .reveal-item.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-section {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .reveal-section.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .ai-tool-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .ai-tool-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '-40px' });

  document.querySelectorAll('.reveal-item, .reveal-section, .ai-tool-card').forEach((el) => {
    observer.observe(el);
  });
</script>