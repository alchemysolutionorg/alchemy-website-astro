---
import TechGrid from '../islands/TechGrid';

interface TechItem {
  name: string;
  color: string;
  category: "ai" | "frontend" | "backend" | "devops" | "database";
  featured?: boolean;
}

interface AITool {
  name: string;
  tag: string;
  desc: string;
  color: string;
  icon: "cloud" | "cursor" | "nodes" | "shield";
}

interface Props {
  data?: {
    sectionTitle?: string;
    sectionSubtitle?: string;
    aiTools?: AITool[];
    techStack?: TechItem[];
    rhcsaCertified?: boolean;
  };
}

const defaultAITools: AITool[] = [
  { name: "OpenAI Codex", tag: "Cloud Agents", color: "#74aa9c", icon: "cloud", desc: "Parallel cloud agents work the ticket backlog — migrations, test backfills, dependency upgrades — while humans review." },
  { name: "Cursor", tag: "AI-First IDE", color: "#60a5fa", icon: "cursor", desc: "Codebase-aware pair programming: whole-repo context, inline edits and agent runs without leaving the editor." },
  { name: "MCP", tag: "Model Context Protocol", color: "#06b6d4", icon: "nodes", desc: "The open standard wiring agents to repos, docs and infra. We ship MCP servers, not just consume them." },
  { name: "Evals & Guardrails", tag: "AI Quality", color: "#34d399", icon: "shield", desc: "Automated eval suites, tracing and regression gates keep every LLM feature honest once it hits production." },
];

const terminalLines = [
  { type: "cmd", text: 'claude "refactor billing module, add tests"' },
  { type: "dim", text: "⠿ indexing codebase… 214 files mapped" },
  { type: "dim", text: "⠿ running test suite… 128 passed, 0 failed" },
  { type: "ok", text: "✓ 14 files changed · 42 tests added · coverage 87% → 94%" },
  { type: "pr", text: "✓ PR #482 opened → awaiting human review" },
  { type: "dim", text: "↳ agent idle — picking up next ticket…" },
];

const toolIcons: Record<AITool["icon"], string> = {
  cloud: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  cursor: '<path d="M4 3l16 7-7 2-2 7L4 3z"/>',
  nodes: '<circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="5" r="2.5"/><circle cx="19" cy="19" r="2.5"/><line x1="7.5" y1="11" x2="16.5" y2="6"/><line x1="7.5" y1="13" x2="16.5" y2="18"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};

const defaultTechStack: TechItem[] = [
  // AI / ML
  { name: "Claude", color: "#cc785c", category: "ai", featured: true },
  { name: "MCP", color: "#06b6d4", category: "ai", featured: true },
  { name: "Multi-Agent", color: "#a855f7", category: "ai", featured: true },
  { name: "LangChain", color: "#65c179", category: "ai", featured: true },
  { name: "OpenAI", color: "#74aa9c", category: "ai" },
  { name: "Anthropic", color: "#cc785c", category: "ai" },
  { name: "Mistral AI", color: "#ff7000", category: "ai" },
  { name: "Hugging Face", color: "#ffbd13", category: "ai" },
  { name: "Ollama", color: "#e0e0e0", category: "ai" },
  { name: "Replicate", color: "#a855f7", category: "ai" },
  { name: "LangGraph", color: "#7fc8ff", category: "ai" },
  { name: "NVIDIA", color: "#76b900", category: "ai" },
  { name: "PyTorch", color: "#ee4c2c", category: "ai" },
  // Frontend
  { name: "React.js", color: "#61dafb", category: "frontend" },
  { name: "Next.js", color: "#e0e0e0", category: "frontend" },
  { name: "TypeScript", color: "#3178c6", category: "frontend" },
  { name: "Tailwind CSS", color: "#06b6d4", category: "frontend" },
  { name: "Vite", color: "#646cff", category: "frontend" },
  { name: "SvelteKit", color: "#ff3e00", category: "frontend" },
  { name: "Astro.js", color: "#ff5d01", category: "frontend" },
  { name: "Framer Motion", color: "#0055ff", category: "frontend" },
  { name: "Vercel", color: "#e0e0e0", category: "frontend" },
  { name: "Bun", color: "#fbf0df", category: "frontend" },
  { name: "pnpm", color: "#f69220", category: "frontend" },
  // Backend
  { name: "Java", color: "#f89820", category: "backend" },
  { name: "Spring Boot", color: "#6db33f", category: "backend" },
  { name: "Go", color: "#00add8", category: "backend" },
  { name: "Python", color: "#3776ab", category: "backend" },
  { name: "FastAPI", color: "#009688", category: "backend" },
  { name: "Django", color: "#44b78b", category: "backend" },
  { name: "Node.js", color: "#339933", category: "backend" },
  { name: "NestJS", color: "#e0234e", category: "backend" },
  { name: "Express", color: "#c0c0c0", category: "backend" },
  { name: "Rust", color: "#ce412b", category: "backend" },
  // DevOps
  { name: "Docker", color: "#2496ed", category: "devops" },
  { name: "Kubernetes", color: "#326ce5", category: "devops" },
  { name: "Terraform", color: "#7b42bc", category: "devops" },
  { name: "Ansible", color: "#ee0000", category: "devops" },
  { name: "Red Hat", color: "#ee0000", category: "devops" },
  { name: "GitHub Actions", color: "#2088ff", category: "devops" },
  { name: "Jenkins", color: "#d33833", category: "devops" },
  { name: "Prometheus", color: "#e6522c", category: "devops" },
  { name: "Grafana", color: "#f46800", category: "devops" },
  { name: "Linux", color: "#fcc624", category: "devops" },
  { name: "Cloudflare", color: "#f38020", category: "devops" },
  { name: "Argo CD", color: "#ef7b4d", category: "devops" },
  { name: "OpenTelemetry", color: "#f5a800", category: "devops" },
  // Database
  { name: "PostgreSQL", color: "#336791", category: "database" },
  { name: "MongoDB", color: "#4db33d", category: "database" },
  { name: "Redis", color: "#dc382d", category: "database" },
  { name: "MySQL", color: "#4479a1", category: "database" },
  { name: "Supabase", color: "#3fcf8e", category: "database" },
  { name: "Prisma", color: "#e0e0e0", category: "database" },
  { name: "Drizzle", color: "#c5f74f", category: "database" },
];

const { data } = Astro.props as Props;
const aiTools = data?.aiTools || defaultAITools;
const techStack = data?.techStack || defaultTechStack;
---

<section id="engineering" class="py-32 relative">
  <!-- Background glows -->
  <div class="absolute top-1/4 left-1/4 w-[600px] h-[300px] bg-violet-500/5 rounded-full blur-[140px] pointer-events-none" />
  <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[300px] bg-blue-500/5 rounded-full blur-[140px] pointer-events-none" />

  <div class="container mx-auto px-6 relative z-10">

    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-4 reveal-item">
        Engineering Culture
      </p>
      <h2 class="text-4xl md:text-5xl font-display font-bold mb-6 reveal-item">
        Built by <span class="text-gradient">Masters of the Craft</span>
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto reveal-item">
        {data?.sectionSubtitle || "Agentic AI workflows, certified infrastructure engineers, and deep mastery across the full modern stack — agents draft, engineers decide."}
      </p>
    </div>

    <!-- AI Tools spotlight -->
    <div class="mb-20 reveal-section">
      <div class="flex items-center gap-3 mb-8">
        <div class="w-10 h-10 rounded-xl bg-primary/10 border border-primary/30 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
            <path d="M12 8V4H8"/>
            <rect width="16" height="12" x="4" y="8" rx="2"/>
            <path d="M2 14h2"/>
            <path d="M20 14h2"/>
            <path d="M15 13v2"/>
            <path d="M9 13v2"/>
          </svg>
        </div>
        <div>
          <h3 class="text-xl font-bold font-display">AI-Augmented Development</h3>
          <p class="text-sm text-muted-foreground">Agents draft, engineers decide — AI is embedded in every stage of how we ship</p>
        </div>
        <span class="ml-auto px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 border border-primary/30 text-primary hidden sm:inline-flex items-center gap-1.5 animate-pulse">
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
          Active in every sprint
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 auto-rows-fr">
        <!-- Featured: live agent session terminal -->
        <div
          class="glass-card border border-violet-500/30 rounded-2xl relative overflow-hidden group cursor-default ai-tool-card sm:col-span-2 lg:col-span-2 lg:row-span-2 flex flex-col"
          style="transition-delay: 0s"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-violet-500/15 to-transparent opacity-60 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl" />
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-violet-500/80 to-transparent" />
          <div class="relative z-10 flex flex-col h-full p-5">
            <div class="flex items-center gap-2 pb-4 border-b border-white/8">
              <span class="w-2.5 h-2.5 rounded-full bg-red-400/70" />
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/70" />
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/70" />
              <span class="ml-2 text-xs font-mono text-muted-foreground">claude — agent session</span>
              <span class="ml-auto flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-wider text-violet-400">
                <span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-pulse" />
                live
              </span>
            </div>
            <div
              class="term-body relative flex-1 flex flex-col justify-end font-mono text-xs md:text-sm leading-relaxed pt-4 min-h-[150px]"
              data-term
              data-lines={JSON.stringify(terminalLines)}
              aria-label="Example autonomous agent session: refactor billing module, add tests, open pull request for human review"
            />
            <div class="relative z-10 pt-4 mt-auto">
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-foreground/5 border border-white/10 text-muted-foreground inline-block mb-2">
                Agentic Engineering
              </span>
              <h4 class="font-bold text-base font-display mb-1.5">Claude Code</h4>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Autonomous agents draft refactors, write tests and open PRs against real repos — every diff lands only after senior human review.
              </p>
            </div>
          </div>
        </div>

        {aiTools.map((tool, i) => (
          <div
            class="glass-card border rounded-2xl p-5 relative overflow-hidden group cursor-default ai-tool-card"
            style={`border-color: ${tool.color}30; transition-delay: ${(i + 1) * 0.08}s`}
          >
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl"
              style={`background: radial-gradient(circle at 30% 20%, ${tool.color}1f 0%, transparent 65%)`}
            />
            <div
              class="absolute top-0 left-0 right-0 h-[2px] opacity-60 group-hover:opacity-100 transition-opacity"
              style={`background: linear-gradient(90deg, ${tool.color}, transparent)`}
            />
            <div class="relative z-10">
              <div
                class="w-9 h-9 rounded-xl flex items-center justify-center mb-4"
                style={`background: ${tool.color}18; border: 1px solid ${tool.color}35; color: ${tool.color}`}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={toolIcons[tool.icon]} />
              </div>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-foreground/5 border border-white/10 text-muted-foreground mb-2.5 inline-block">
                {tool.tag}
              </span>
              <h4 class="font-bold text-base font-display mb-2">{tool.name}</h4>
              <p class="text-xs text-muted-foreground leading-relaxed">{tool.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- RHCSA certification -->
    <div class="mb-20 glass-card border border-emerald-400/30 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center gap-4 relative overflow-hidden reveal-section">
      <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/10 to-transparent pointer-events-none rounded-2xl" />
      <div class="relative z-10 w-14 h-14 rounded-2xl bg-emerald-400/10 border border-emerald-400/30 flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400">
          <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div class="relative z-10 flex-1">
        <div class="flex flex-wrap items-center gap-2 mb-1">
          <h4 class="font-bold text-lg font-display">Red Hat Certified System Administrators</h4>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-400/15 border border-emerald-400/40 text-emerald-400 tracking-wide">
            RHCSA Certified
          </span>
        </div>
        <p class="text-muted-foreground text-sm leading-relaxed">
          Our infrastructure team holds active <strong class="text-foreground">RHCSA</strong> certifications —
          enterprise-grade Linux expertise from hardened production deployments to SELinux policies,
          systemd service management, and kernel-level network configuration.
        </p>
      </div>
      <div class="relative z-10 hidden lg:flex flex-col items-center gap-1 flex-shrink-0">
        <div class="text-3xl font-black font-display text-emerald-400">RHCSA</div>
        <div class="text-xs text-muted-foreground tracking-widest uppercase">Red Hat</div>
      </div>
    </div>

    <!-- Tech Stack Wall -->
    <div class="reveal-section">
      <!-- Section label -->
      <div class="flex flex-col items-center gap-4 mb-10">
        <h3 class="text-2xl md:text-3xl font-bold font-display text-center">
          The Full <span class="text-gradient">Technology Arsenal</span>
        </h3>
        <p class="text-sm text-muted-foreground text-center">Every layer of the modern stack, mastered — filter to explore</p>
      </div>

      <!-- Background container with subtle depth -->
      <div class="relative rounded-3xl overflow-hidden">
        <!-- Multi-color glow blobs in background -->
        <div class="absolute top-8 left-16 w-48 h-48 rounded-full opacity-20 blur-[60px] pointer-events-none" style="background: #a855f7" />
        <div class="absolute top-4 right-24 w-36 h-36 rounded-full opacity-15 blur-[50px] pointer-events-none" style="background: #60a5fa" />
        <div class="absolute bottom-12 left-1/3 w-40 h-40 rounded-full opacity-12 blur-[55px] pointer-events-none" style="background: #34d399" />
        <div class="absolute bottom-4 right-16 w-44 h-44 rounded-full opacity-15 blur-[60px] pointer-events-none" style="background: #fb923c" />

        <!-- Outer container (no backdrop-filter: it forces re-blur every animation frame) -->
        <div class="relative rounded-3xl p-5 border border-white/8 bg-white/40 dark:bg-white/[0.03] shadow-[0_8px_32px_0_rgba(0,0,0,0.25),inset_0_1px_0_rgba(255,255,255,0.05)]">
          <TechGrid client:visible techStack={techStack} />
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .reveal-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .reveal-item.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-section {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .reveal-section.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .ai-tool-card {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .ai-tool-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .term-body::before {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.02) 0 1px, transparent 1px 4px);
    pointer-events: none;
  }
  .term-body :global(.term-line) {
    position: relative;
    white-space: pre-wrap;
    word-break: break-word;
    min-height: 1.4em;
  }
  .term-body :global(.t-cmd) { color: hsl(var(--foreground)); }
  .term-body :global(.t-cmd)::before { content: "$ "; color: #a855f7; }
  .term-body :global(.t-dim) { color: hsl(var(--muted-foreground)); }
  .term-body :global(.t-ok) { color: #34d399; }
  .term-body :global(.t-pr) { color: #a78bfa; }
  .term-body :global(.term-caret) {
    display: inline-block;
    width: 7px;
    height: 1.05em;
    vertical-align: text-bottom;
    margin-left: 2px;
    background: #a855f7;
    animation: term-blink 1s steps(1) infinite;
  }
  @keyframes term-blink {
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .term-body :global(.term-caret) { animation: none; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '-40px' });

  document.querySelectorAll('.reveal-item, .reveal-section, .ai-tool-card').forEach((el) => {
    observer.observe(el);
  });

  const term = document.querySelector<HTMLElement>('[data-term]');
  if (term) {
    const lines = JSON.parse(term.dataset.lines || '[]') as { type: string; text: string }[];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const lineClass = (t: string) => `term-line t-${t}`;

    const renderStatic = () => {
      term.innerHTML = '';
      lines.forEach((l) => {
        const div = document.createElement('div');
        div.className = lineClass(l.type);
        div.textContent = l.text;
        term.appendChild(div);
      });
    };

    const runLoop = async () => {
      while (true) {
        term.innerHTML = '';
        for (const line of lines) {
          const div = document.createElement('div');
          div.className = lineClass(line.type);
          term.appendChild(div);
          if (line.type === 'cmd') {
            const caret = document.createElement('span');
            caret.className = 'term-caret';
            div.appendChild(caret);
            for (const ch of line.text) {
              caret.insertAdjacentText('beforebegin', ch);
              await sleep(34 + Math.random() * 40);
            }
            await sleep(420);
            caret.remove();
          } else {
            await sleep(300);
            div.textContent = line.text;
            await sleep(240);
          }
        }
        const caret = document.createElement('span');
        caret.className = 'term-caret';
        term.lastElementChild?.appendChild(caret);
        await sleep(3800);
      }
    };

    if (reduced) renderStatic();
    else runLoop();
  }
</script>