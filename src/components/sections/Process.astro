---
interface ProcessStep {
  num: string;
  phase: string;
  title: string;
  desc: string;
  icon: string;
  color: string;
  tag: string;
}

interface Props {
  data?: {
    sectionTitle?: string;
    sectionSubtitle?: string;
    steps?: ProcessStep[];
  };
}

const defaultSteps = [
  { num: "01", phase: "Phase 1", title: "Discovery & Blueprint", desc: "Deep dives into your business constraints, technical requirements, and aesthetic goals. We map the territory with surgical precision before a single line of code is written.", icon: "Search", color: "#8b5cf6", tag: "Requirements" },
  { num: "02", phase: "Phase 2", title: "The Crucible", desc: "Rapid prototyping and core architecture design. Ideas are stress-tested, validated against real-world constraints, and refined under controlled pressure.", icon: "FlaskConical", color: "#f59e0b", tag: "Architecture" },
  { num: "03", phase: "Phase 3", title: "Transmutation", desc: "Intense execution — scalable backend systems, AI model integration, and polished frontend interfaces delivered with obsessive craftsmanship and zero technical debt.", icon: "Cpu", color: "#06b6d4", tag: "Engineering" },
  { num: "04", phase: "Phase 4", title: "Ascension", desc: "Rigorous testing, production deployment, and seamless handover. Your product is released into the world — battle-tested, monitored, and built to scale.", icon: "Rocket", color: "#10b981", tag: "Launch" },
];

const { data } = Astro.props as Props;
const steps = data?.steps || defaultSteps;
const STEP_OFFSET = 88;

// Icon SVG paths
const iconPaths: Record<string, string> = {
  Search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  FlaskConical: '<path d="M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2"/><path d="M8.5 2h7"/><path d="M7 16h10"/>',
  Cpu: '<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
  Rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
};
---

<section id="process" class="py-32 relative overflow-hidden">
  <!-- Background depth -->
  <div class="absolute inset-0 bg-foreground/[0.018] pointer-events-none" />
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-primary/4 rounded-full blur-[160px] pointer-events-none" />

  <div class="container mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="text-center mb-20">
      <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-4 reveal-item">Methodology</p>
      <h2 class="text-4xl md:text-5xl font-display font-bold mb-6 reveal-item">
        The <span class="text-gradient">Alchemical</span> Process
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto reveal-item">
        {data?.sectionSubtitle || "A disciplined methodology designed to minimize risk and produce extraordinary outcomes — on time, every time."}
      </p>
    </div>

    <!-- Staircase Timeline (Desktop) -->
    <div class="hidden lg:block">
      <div class="relative" style={`min-height: ${320 + STEP_OFFSET * (steps.length - 1) + 80}px`}>
        <!-- Vertical dashed column guides -->
        {[1, 2, 3].map((col) => (
          <div
            class="absolute top-0 origin-top column-line"
            style={`left: ${(col / 4) * 100}%; height: ${220 + STEP_OFFSET * (steps.length - 1)}px; border-left: 1px dashed rgba(255,255,255,0.12);`}
          />
        ))}

        <!-- Step cards in staircase positions -->
        {steps.map((step, i) => (
          <div
            class="absolute process-card"
            style={`left: ${(i / 4) * 100}%; top: ${i * STEP_OFFSET}px; width: calc(25% - 20px); transition-delay: ${i * 0.18}s`}
          >
            <div
              class="group relative glass-card rounded-2xl p-5 border overflow-hidden cursor-default hover-lift"
              style={`border-color: ${step.color}28`}
            >
              <!-- Top color accent -->
              <div
                class="absolute top-0 left-0 right-0 h-[2px] rounded-t-2xl"
                style={`background: linear-gradient(90deg, ${step.color}, ${step.color}44)`}
              />

              <!-- Hover glow -->
              <div
                class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-400 pointer-events-none"
                style={`background: radial-gradient(circle at 30% 30%, ${step.color}18 0%, transparent 65%)`}
              />

              <div class="relative z-10">
                <!-- Icon + tag row -->
                <div class="flex items-start justify-between mb-4">
                  <div
                    class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0"
                    style={`background: ${step.color}18; border: 1px solid ${step.color}30`}
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={step.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[step.icon]} />
                  </div>
                  <span
                    class="text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full"
                    style={`color: ${step.color}; background: ${step.color}18; border: 1px solid ${step.color}28`}
                  >
                    {step.tag}
                  </span>
                </div>

                <!-- Step number -->
                <div
                  class="text-5xl font-black font-display leading-none mb-2 select-none"
                  style={`color: ${step.color}20`}
                >
                  {step.num}
                </div>

                <!-- Title -->
                <h3 class="text-base font-bold font-display mb-2 leading-snug">{step.title}</h3>

                <!-- Description -->
                <p class="text-xs text-muted-foreground leading-relaxed">{step.desc}</p>
              </div>
            </div>

            <!-- Arrow to next step -->
            {i < steps.length - 1 && (
              <div
                class="absolute -right-5 top-1/2 -translate-y-1/2 flex items-center justify-center arrow-icon"
                style={`transition-delay: ${i * 0.18 + 0.4}s`}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke={step.color}
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="opacity-40"
                >
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </div>
            )}
          </div>
        ))}

        <!-- Bottom dashed horizontal timeline -->
        <div class="absolute left-0 right-0" style={`top: ${320 + STEP_OFFSET * (steps.length - 1)}px`}>
          <div class="origin-left border-t border-dashed timeline-line" style="border-color: rgba(255,255,255,0.14)" />

          <!-- Phase labels -->
          <div class="grid grid-cols-4 mt-4">
            {steps.map((step, i) => (
              <div class="flex flex-col items-start pl-1 phase-label" style={`transition-delay: ${0.7 + i * 0.1}s`}>
                <div
                  class="w-1 h-3 mb-1.5 rounded-full"
                  style={`background: ${step.color}; opacity: 0.5`}
                />
                <span class="text-xs text-muted-foreground/60 font-medium">{step.phase}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile: vertical stack -->
    <div class="lg:hidden space-y-4 relative">
      <div class="absolute left-5 top-0 bottom-0 border-l border-dashed border-black/10 dark:border-white/10" />

      {steps.map((step, i) => (
        <div
          class="relative pl-14 process-card"
          style={`transition-delay: ${i * 0.12}s`}
        >
          <!-- Step circle on timeline -->
          <div
            class="absolute left-0 top-5 w-10 h-10 rounded-full flex items-center justify-center border"
            style={`background: ${step.color}15; border-color: ${step.color}40`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={step.color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[step.icon]} />
          </div>

          <div
            class="glass-card rounded-2xl p-5 border overflow-hidden relative"
            style={`border-color: ${step.color}28`}
          >
            <div
              class="absolute top-0 left-0 right-0 h-[2px] rounded-t-2xl"
              style={`background: ${step.color}`}
            />
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs text-muted-foreground font-medium">{step.phase}</span>
              <span
                class="text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 rounded-full"
                style={`color: ${step.color}; background: ${step.color}18`}
              >
                {step.tag}
              </span>
            </div>
            <h3 class="text-lg font-bold font-display mb-2">{step.title}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-card {
    opacity: 0;
    transform: translateX(-24px) translateY(16px);
    transition: opacity 0.55s ease-out, transform 0.55s ease-out;
  }
  .process-card.visible {
    opacity: 1;
    transform: translateX(0) translateY(0);
  }
  .hover-lift:hover {
    transform: translateY(-6px) scale(1.02);
    transition: transform 0.2s ease-out;
  }
  .reveal-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .reveal-item.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .column-line {
    opacity: 0;
    transform: scaleY(0);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .column-line.visible {
    opacity: 1;
    transform: scaleY(1);
  }
  .arrow-icon {
    opacity: 0;
    transform: scale(0);
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
  }
  .arrow-icon.visible {
    opacity: 1;
    transform: scale(1);
  }
  .timeline-line {
    opacity: 0;
    transform: scaleX(0);
    transition: opacity 1s ease-out, transform 1s ease-out;
  }
  .timeline-line.visible {
    opacity: 1;
    transform: scaleX(1);
  }
  .phase-label {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .phase-label.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.process-card, .reveal-item, .column-line, .arrow-icon, .timeline-line, .phase-label').forEach((el) => {
    observer.observe(el);
  });
</script>