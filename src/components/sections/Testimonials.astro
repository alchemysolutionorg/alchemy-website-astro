---
interface Metric {
  value: number;
  decimals?: number;
  prefix?: string;
  suffix?: string;
  label: string;
}

interface Testimonial {
  quote: string;
  author: string;
  role: string;
  accentColor?: string;
  metric?: Metric;
}

interface Props {
  data?: {
    sectionTitle?: string;
    sectionSubtitle?: string;
    testimonials?: Testimonial[];
  };
}

const defaultTestimonials: Testimonial[] = [
  {
    quote:
      "Alchemy didn't just build us a platform; they fundamentally changed how we operate. Their AI agents saved us thousands of hours in the first quarter alone.",
    author: "Elena Vance",
    role: "CTO, Nexus Corp",
    accentColor: "#8b5cf6",
    metric: { value: 4000, suffix: "+", label: "hours saved in the first quarter" },
  },
  {
    quote:
      "The sheer aesthetic quality combined with robust engineering is rare. They are true craftsmen. Our conversion rates doubled after the redesign.",
    author: "Marcus Thorne",
    role: "Founder, Aether Labs",
    accentColor: "#06b6d4",
    metric: { value: 2.1, decimals: 1, suffix: "×", label: "conversion rate after the redesign" },
  },
  {
    quote:
      "Working with them felt like magic. We handed them a messy set of requirements, and they handed back an elegant, flawless enterprise application.",
    author: "Sarah Lin",
    role: "VP Product, Sentinel Data",
    accentColor: "#f59e0b",
    metric: { value: 6, suffix: " wks", label: "from messy brief to production launch" },
  },
];

const { data } = Astro.props as Props;
const testimonials = data?.testimonials?.length ? data.testimonials : defaultTestimonials;
const AUTOPLAY_MS = 7500;

const initialsOf = (name: string) =>
  name
    .split(" ")
    .filter(Boolean)
    .map((n) => n[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
---

<section
  id="testimonials"
  class="py-32 relative overflow-hidden tst-section"
  style={`--tst-accent: ${testimonials[0].accentColor || "#8b5cf6"}`}
  data-autoplay={String(AUTOPLAY_MS)}
>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary/6 via-background to-background pointer-events-none" />
  <div class="tst-glow absolute -top-24 left-1/4 w-[560px] h-[560px] rounded-full blur-[180px] pointer-events-none" />
  <div class="tst-glow-2 absolute -bottom-32 right-[10%] w-[420px] h-[420px] rounded-full blur-[160px] pointer-events-none" />

  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center mb-16 md:mb-20">
      <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-4 reveal-item">
        Client Stories
      </p>
      <h2 class="text-4xl md:text-5xl font-display font-bold reveal-item">
        {data?.sectionTitle ? data.sectionTitle : <>Words from the <span class="text-gradient">Initiated</span></>}
      </h2>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto mt-6 reveal-item">
        {data?.sectionSubtitle ||
          "Real outcomes from teams who trusted us with their most ambitious ideas."}
      </p>
    </div>

    <div
      class="tst-grid grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-6 lg:gap-8 items-stretch reveal-item"
      role="group"
      aria-roledescription="carousel"
      aria-label="Client testimonials"
    >
      <!-- Featured stage -->
      <div class="tst-stage group relative rounded-3xl overflow-hidden" data-stage>
        <div class="tst-surface absolute inset-0 rounded-3xl" style="backdrop-filter: blur(24px);" />
        <div
          class="absolute top-0 left-0 right-0 h-[2px] tst-topline"
        />
        <div class="tst-spotlight absolute inset-0 rounded-3xl pointer-events-none" />

        <div
          class="tst-ghost absolute top-4 right-5 md:right-8 font-display font-black text-[110px] md:text-[150px] leading-none select-none pointer-events-none"
          data-ghost
          aria-hidden="true"
        >
          01
        </div>

        <div class="relative z-10 p-8 md:p-12 lg:p-14 flex flex-col min-h-[440px] md:min-h-[420px]">
          <div class="relative flex-1" data-slides>
            {testimonials.map((t, i) => {
              const accent = t.accentColor || "#8b5cf6";
              return (
                <article
                  class="tst-slide flex flex-col h-full"
                  data-slide={String(i)}
                  data-accent={accent}
                  aria-hidden={i === 0 ? "false" : "true"}
                  aria-roledescription="slide"
                  aria-label={`${i + 1} of ${testimonials.length}`}
                >
                  <svg
                    class="w-10 h-10 md:w-12 md:h-12 mb-6 tst-quote-mark"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                  </svg>

                  <blockquote class="text-xl md:text-2xl lg:text-[27px] leading-snug md:leading-snug font-display font-light text-foreground/90 max-w-3xl">
                    {t.quote.split(" ").map((word, wi) => (
                      <span class="tst-word" aria-hidden="true">
                        <span class="tst-word-inner" style={`transition-delay: ${120 + wi * 34}ms`}>
                          {word}&nbsp;
                        </span>
                      </span>
                    ))}
                    <span class="sr-only">{t.quote}</span>
                  </blockquote>

                  {t.metric && (
                    <div class="flex items-baseline gap-3 mt-8 tst-metric">
                      <span
                        class="font-display font-black text-3xl md:text-4xl tracking-tight tst-metric-value"
                        data-value={String(t.metric.value)}
                        data-decimals={String(t.metric.decimals ?? 0)}
                        data-prefix={t.metric.prefix || ""}
                        data-suffix={t.metric.suffix || ""}
                      >
                        0
                      </span>
                      <span class="text-sm text-muted-foreground max-w-[240px] leading-tight">
                        {t.metric.label}
                      </span>
                    </div>
                  )}

                  <div class="flex items-center gap-4 pt-6 mt-8 border-t border-white/8">
                    <div class="tst-avatar relative w-12 h-12 flex-shrink-0" style={`--tst-a: ${accent}`}>
                      <span class="tst-avatar-ring absolute inset-0 rounded-full" />
                      <span
                        class="absolute inset-[3px] rounded-full flex items-center justify-center text-sm font-bold font-display"
                        style={`background: ${accent}22; color: ${accent}`}
                      >
                        {initialsOf(t.author)}
                      </span>
                    </div>
                    <div>
                      <div class="font-bold font-display text-base">{t.author}</div>
                      <div class="text-sm text-muted-foreground">{t.role}</div>
                    </div>
                    <div class="ml-auto hidden md:block text-right">
                      <div
                        class="text-[10px] font-bold tracking-widest uppercase px-3 py-1 rounded-full"
                        style={`color: ${accent}; background: ${accent}14; border: 1px solid ${accent}30`}
                      >
                        Verified Client
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- Controls -->
          <div class="flex items-center gap-5 mt-8">
            <button
              type="button"
              class="tst-nav-btn"
              data-prev
              aria-label="Previous testimonial"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <button
              type="button"
              class="tst-nav-btn"
              data-next
              aria-label="Next testimonial"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>

            <div class="tst-progress flex-1 h-[3px] rounded-full overflow-hidden" aria-hidden="true">
              <div class="tst-progress-fill h-full w-full origin-left" data-progress></div>
            </div>

            <div class="font-display text-sm text-muted-foreground tabular-nums tracking-widest">
              <span class="tst-counter text-foreground font-bold" data-counter>01</span>
              <span class="mx-1">/</span>
              {String(testimonials.length).padStart(2, "0")}
            </div>
          </div>
        </div>
      </div>

      <!-- Author rail -->
      <div class="tst-rail flex lg:flex-col gap-3 overflow-x-auto lg:overflow-visible pb-1 lg:pb-0 snap-x lg:snap-none" data-rail>
        {testimonials.map((t, i) => {
          const accent = t.accentColor || "#8b5cf6";
          return (
            <button
              type="button"
              class="tst-rail-item group relative flex items-center gap-4 rounded-2xl p-4 pr-5 text-left flex-shrink-0 lg:flex-1 snap-start w-[240px] lg:w-full cursor-pointer"
              data-rail-item={String(i)}
              data-accent={accent}
              aria-label={`Show testimonial from ${t.author}`}
            >
              <span class="tst-rail-bar absolute left-0 top-4 bottom-4 w-[3px] rounded-full" aria-hidden="true" />
              <span
                class="w-10 h-10 rounded-full flex items-center justify-center text-xs font-bold font-display flex-shrink-0 transition-transform duration-300 group-hover:scale-105"
                style={`background: ${accent}1c; border: 1px solid ${accent}40; color: ${accent}`}
              >
                {initialsOf(t.author)}
              </span>
              <span class="min-w-0">
                <span class="block font-display font-bold text-sm truncate">{t.author}</span>
                <span class="block text-xs text-muted-foreground truncate">{t.role}</span>
              </span>
              <svg
                class="ml-auto w-4 h-4 flex-shrink-0 tst-rail-arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
              </svg>
            </button>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  @property --tst-accent {
    syntax: "<color>";
    inherits: true;
    initial-value: #8b5cf6;
  }

  .tst-section {
    transition: --tst-accent 0.9s ease;
  }

  .tst-glow {
    background: color-mix(in srgb, var(--tst-accent) 9%, transparent);
    transition: background 0.9s ease;
  }
  .tst-glow-2 {
    background: color-mix(in srgb, var(--tst-accent) 6%, transparent);
    transition: background 0.9s ease;
  }

  .tst-surface {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--tst-accent) 10%, transparent),
      0 24px 64px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition: box-shadow 0.9s ease, background 0.4s ease, border-color 0.4s ease;
  }
  :global(.light) .tst-surface {
    background: rgba(255, 255, 255, 0.6);
    border-color: rgba(0, 0, 0, 0.06);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--tst-accent) 14%, transparent),
      0 24px 64px rgba(31, 38, 135, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .tst-topline {
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--tst-accent) 85%, transparent),
      transparent
    );
    transition: background 0.9s ease;
  }

  .tst-spotlight {
    --mx: 50%;
    --my: 0%;
    background: radial-gradient(
      420px circle at var(--mx) var(--my),
      color-mix(in srgb, var(--tst-accent) 10%, transparent),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .tst-stage:hover .tst-spotlight {
    opacity: 1;
  }

  .tst-ghost {
    color: color-mix(in srgb, var(--tst-accent) 10%, transparent);
    transition: color 0.9s ease;
  }
  .tst-ghost.tst-ghost-swap {
    animation: tst-ghost-in 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes tst-ghost-in {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.94);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  .tst-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .tst-slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .tst-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }
  .tst-word-inner {
    display: inline-block;
    transform: translateY(115%);
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .tst-slide.is-active .tst-word-inner {
    transform: translateY(0);
  }

  .tst-quote-mark {
    color: color-mix(in srgb, var(--tst-accent) 80%, transparent);
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--tst-accent) 45%, transparent));
    opacity: 0;
    transform: scale(0.6) rotate(-8deg);
    transition:
      opacity 0.5s ease 0.05s,
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.05s,
      color 0.9s ease,
      filter 0.9s ease;
  }
  .tst-slide.is-active .tst-quote-mark {
    opacity: 0.9;
    transform: scale(1) rotate(0deg);
  }

  .tst-metric,
  .tst-slide > div:last-child {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease 0.55s, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.55s;
  }
  .tst-slide.is-active .tst-metric,
  .tst-slide.is-active > div:last-child {
    opacity: 1;
    transform: translateY(0);
  }

  .tst-metric-value {
    color: color-mix(in srgb, var(--tst-accent) 85%, white 15%);
    text-shadow: 0 0 32px color-mix(in srgb, var(--tst-accent) 40%, transparent);
    transition: color 0.9s ease;
    font-variant-numeric: tabular-nums;
  }

  .tst-avatar-ring {
    background: conic-gradient(
      from 0deg,
      color-mix(in srgb, var(--tst-a) 90%, transparent),
      transparent 40%,
      transparent 60%,
      color-mix(in srgb, var(--tst-a) 90%, transparent)
    );
    animation: tst-spin 6s linear infinite paused;
  }
  .tst-slide.is-active .tst-avatar-ring {
    animation-play-state: running;
  }
  @keyframes tst-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .tst-nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: hsl(var(--foreground));
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }
  :global(.light) .tst-nav-btn {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
  }
  .tst-nav-btn:hover {
    background: color-mix(in srgb, var(--tst-accent) 18%, transparent);
    border-color: color-mix(in srgb, var(--tst-accent) 45%, transparent);
    color: color-mix(in srgb, var(--tst-accent) 70%, white 30%);
    transform: translateY(-1px);
  }
  .tst-nav-btn:active {
    transform: translateY(0) scale(0.94);
  }
  .tst-nav-btn:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--tst-accent) 70%, transparent);
    outline-offset: 2px;
  }

  .tst-progress {
    background: rgba(255, 255, 255, 0.08);
  }
  :global(.light) .tst-progress {
    background: rgba(0, 0, 0, 0.08);
  }
  .tst-progress-fill {
    background: color-mix(in srgb, var(--tst-accent) 85%, white 15%);
    transform: scaleX(0);
    will-change: transform;
    transition: background 0.9s ease;
  }

  .tst-rail-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: background 0.35s ease, border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
  }
  :global(.light) .tst-rail-item {
    background: rgba(255, 255, 255, 0.6);
    border-color: rgba(0, 0, 0, 0.07);
  }
  .tst-rail-item:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateX(4px);
  }
  :global(.light) .tst-rail-item:hover {
    background: rgba(255, 255, 255, 0.9);
  }
  .tst-rail-item:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--tst-accent) 70%, transparent);
    outline-offset: 2px;
  }
  .tst-rail-bar {
    background: transparent;
    transition: background 0.4s ease, top 0.4s ease, bottom 0.4s ease;
  }
  .tst-rail-arrow {
    color: color-mix(in srgb, var(--tst-accent) 80%, white 20%);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }
  .tst-rail-item.is-active {
    background: color-mix(in srgb, var(--tst-accent) 8%, rgba(255, 255, 255, 0.04));
    border-color: color-mix(in srgb, var(--tst-accent) 35%, transparent);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  :global(.light) .tst-rail-item.is-active {
    background: color-mix(in srgb, var(--tst-accent) 6%, rgba(255, 255, 255, 0.8));
  }
  .tst-rail-item.is-active .tst-rail-bar {
    background: color-mix(in srgb, var(--tst-accent) 85%, transparent);
  }
  .tst-rail-item.is-active .tst-rail-arrow,
  .tst-rail-item:hover .tst-rail-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .reveal-item {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .reveal-item.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tst-section,
    .tst-word-inner,
    .tst-quote-mark,
    .tst-metric,
    .tst-slide > div:last-child,
    .tst-ghost,
    .reveal-item {
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
      animation: none !important;
    }
    .tst-word-inner {
      transform: none;
    }
    .tst-avatar-ring {
      animation: none !important;
    }
  }
</style>

<script>
  const found = document.getElementById('testimonials');
  if (!found) throw new Error('testimonials section missing');
  const section: HTMLElement = found;

  const stage = section.querySelector<HTMLElement>('[data-stage]')!;
  const slides = Array.from(section.querySelectorAll<HTMLElement>('[data-slide]'));
  const railItems = Array.from(section.querySelectorAll<HTMLElement>('[data-rail-item]'));
  const progressFill = section.querySelector<HTMLElement>('[data-progress]')!;
  const counter = section.querySelector<HTMLElement>('[data-counter]')!;
  const ghost = section.querySelector<HTMLElement>('[data-ghost]')!;

  const DURATION = Number(section.dataset.autoplay || 7500);
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let current = -1;
  let elapsed = 0;
  let lastTs: number | null = null;
  let paused = false;
  let inView = false;

  const pad = (n: number) => String(n + 1).padStart(2, '0');
  const fmt = (el: HTMLElement, v: number) => {
    const decimals = Number(el.dataset.decimals || 0);
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const num = v.toLocaleString('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
    return `${prefix}${num}${suffix}`;
  };

  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.value || 0);
    if (reduceMotion) {
      el.textContent = fmt(el, target);
      return;
    }
    const start = performance.now();
    const dur = 1100;
    const step = (now: number) => {
      const p = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 4);
      el.textContent = fmt(el, target * eased);
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  function select(index: number, resetTimer = true) {
    const next = (index + slides.length) % slides.length;
    if (next === current) return;
    current = next;

    const accent = slides[current].dataset.accent || '#8b5cf6';
    section.style.setProperty('--tst-accent', accent);

    slides.forEach((slide, i) => {
      const active = i === current;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      if (active) {
        slide.querySelectorAll<HTMLElement>('.tst-metric-value').forEach(countUp);
      }
    });

    railItems.forEach((item, i) => {
      const active = i === current;
      item.classList.toggle('is-active', active);
      if (active) item.setAttribute('aria-current', 'true');
      else item.removeAttribute('aria-current');
    });

    counter.textContent = pad(current);
    ghost.textContent = pad(current);
    ghost.classList.remove('tst-ghost-swap');
    void ghost.offsetWidth;
    ghost.classList.add('tst-ghost-swap');

    if (resetTimer) elapsed = 0;
  }

  section.querySelector('[data-prev]')?.addEventListener('click', () => select(current - 1));
  section.querySelector('[data-next]')?.addEventListener('click', () => select(current + 1));
  railItems.forEach((item, i) => item.addEventListener('click', () => select(i)));

  stage.addEventListener('pointermove', (e) => {
    const rect = stage.getBoundingClientRect();
    stage.style.setProperty('--mx', `${e.clientX - rect.left}px`);
    stage.style.setProperty('--my', `${e.clientY - rect.top}px`);
  });

  let touchX: number | null = null;
  stage.addEventListener('touchstart', (e) => {
    touchX = e.touches[0].clientX;
  }, { passive: true });
  stage.addEventListener('touchend', (e) => {
    if (touchX === null) return;
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 48) select(current + (dx < 0 ? 1 : -1));
    touchX = null;
  }, { passive: true });

  stage.addEventListener('pointerenter', () => { paused = true; });
  stage.addEventListener('pointerleave', () => { paused = false; });
  section.addEventListener('focusin', () => { paused = true; });
  section.addEventListener('focusout', () => { paused = false; });
  section.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') select(current + 1);
    if (e.key === 'ArrowLeft') select(current - 1);
  });

  function tick(ts: number) {
    if (lastTs === null) lastTs = ts;
    const dt = Math.min(ts - lastTs, 64);
    lastTs = ts;
    if (!paused && inView && !document.hidden && !reduceMotion) {
      elapsed += dt;
      if (elapsed >= DURATION) {
        elapsed = 0;
        select(current + 1, false);
      }
    }
    progressFill.style.transform = `scaleX(${Math.min(elapsed / DURATION, 1)})`;
    requestAnimationFrame(tick);
  }

  new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          inView = true;
          entry.target.classList.add('visible');
          if (current === -1) select(0);
        } else {
          inView = false;
        }
      });
    },
    { threshold: 0.15 },
  ).observe(section);

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 },
  );
  section.querySelectorAll('.reveal-item').forEach((el) => revealObserver.observe(el));

  requestAnimationFrame(tick);
</script>
