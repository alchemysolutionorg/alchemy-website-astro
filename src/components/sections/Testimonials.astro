---
interface Testimonial {
  quote: string;
  author: string;
  role: string;
  accentColor?: string;
}

interface Props {
  data?: {
    sectionTitle?: string;
    testimonials?: Testimonial[];
  };
}

const defaultTestimonials = [
  {
    quote: "Alchemy didn't just build us a platform; they fundamentally changed how we operate. Their AI agents saved us thousands of hours in the first quarter alone.",
    author: "Elena Vance",
    role: "CTO, Nexus Corp",
    accentColor: "#8b5cf6",
  },
  {
    quote: "The sheer aesthetic quality combined with robust engineering is rare. They are true craftsmen. Our conversion rates doubled after the redesign.",
    author: "Marcus Thorne",
    role: "Founder, Aether Labs",
    accentColor: "#06b6d4",
  },
  {
    quote: "Working with them felt like magic. We handed them a messy set of requirements, and they handed back an elegant, flawless enterprise application.",
    author: "Sarah Lin",
    role: "VP Product, Sentinel Data",
    accentColor: "#f59e0b",
  },
];

const { data } = Astro.props as Props;
const testimonials = data?.testimonials || defaultTestimonials;
---

<section id="testimonials" class="py-32 relative overflow-hidden">
  <!-- Background radial -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-primary/6 via-background to-background pointer-events-none" />

  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center mb-20">
      <p class="text-sm font-semibold tracking-widest uppercase text-primary mb-4 reveal-item">
        Client Stories
      </p>
      <h2 class="text-4xl md:text-5xl font-display font-bold reveal-item">
        Words from the <span class="text-gradient">Initiated</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((t, i) => (
        <div
          class="group relative rounded-3xl flex flex-col justify-between overflow-hidden cursor-default testimonial-card"
          style={`
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            backdrop-filter: blur(24px);
            box-shadow: 0 0 0 1px ${t.accentColor}18, 0 8px 32px rgba(0,0,0,0.28), inset 0 1px 0 rgba(255,255,255,0.06);
            transition-delay: ${i * 0.12}s
          `}
        >
          <!-- Top accent stripe -->
          <div
            class="absolute top-0 left-0 right-0 h-[1.5px]"
            style={`background: linear-gradient(90deg, transparent, ${t.accentColor}cc, transparent)`}
          />

          <!-- Hover glow -->
          <div
            class="absolute inset-0 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
            style={`background: radial-gradient(ellipse at 50% 0%, ${t.accentColor}12 0%, transparent 60%)`}
          />

          <!-- Shimmer overlay -->
          <div
            class="absolute inset-0 rounded-3xl pointer-events-none"
            style="background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 50%, rgba(255,255,255,0.02) 100%)"
          />

          <div class="relative z-10 p-8 flex flex-col justify-between h-full">
            <!-- Quote mark -->
            <div class="mb-6">
              <svg
                class="w-9 h-9 mb-5 opacity-50"
                style={`color: ${t.accentColor}`}
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <p class="text-base md:text-lg italic leading-relaxed text-foreground/85">
                "{t.quote}"
              </p>
            </div>

            <!-- Author -->
            <div class="flex items-center gap-3 pt-5 border-t border-white/8">
              <!-- Avatar initials -->
              <div
                class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0"
                style={`background: ${t.accentColor}22; border: 1px solid ${t.accentColor}44; color: ${t.accentColor}`}
              >
                {t.author.split(" ").map((n) => n[0]).join("")}
              </div>
              <div>
                <div class="font-bold text-sm font-display">{t.author}</div>
                <div class="text-xs text-muted-foreground">{t.role}</div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonial-card {
    opacity: 0;
    transform: translateY(28px) scale(0.96);
    transition: opacity 0.55s ease-out, transform 0.55s ease-out;
  }
  .testimonial-card.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .reveal-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .reveal-item.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.testimonial-card, .reveal-item').forEach((el) => {
    observer.observe(el);
  });
</script>