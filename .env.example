# Domain Configuration (required for production)
DOMAIN=your-domain.com
EMAIL=admin@your-domain.com

# Sanity CMS Configuration
# Get these values from your Sanity project dashboard: https://www.sanity.io/manage
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production

# Web3Forms Access Key
# Get yours free at https://web3forms.com — used for contact form submissions
PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Booking page (Zoho Calendar → Appointment Booking)
# Optional — overrides the default link in src/lib/constants.ts
PUBLIC_BOOKING_URL=

# Certbot Configuration
# Set to --test-cert for testing (uses staging Let's Encrypt certificates)
# Leave empty for production certificates
CERTBOT_STAGING=