# Sanity Project Configuration
# Get these from your Sanity project dashboard: https://www.sanity.io/manage

# Studio-specific variables (used by Sanity Studio)
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# Frontend aliases (used by Astro web app)
# These reference the studio variables to avoid duplication
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production

# Optional: API Token for builds (generate in Sanity dashboard)
# SANITY_API_TOKEN=your-api-token