# Domain Configuration (required for production)
DOMAIN=your-domain.com
EMAIL=admin@your-domain.com

# Sanity CMS Configuration
# Get these values from your Sanity project dashboard: https://www.sanity.io/manage
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production

# Certbot Configuration
# Set to --test-cert for testing (uses staging Let's Encrypt servers)
# Leave empty for production certificates
CERTBOT_STAGING=