{
  "name": "alchemy-website",
  "version": "1.0.0",
  "private": true,
  "description": "Alchemy Digital Solutions website - monorepo with Astro frontend and Sanity CMS",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter web dev",
    "dev:studio": "pnpm --filter studio dev",
    "build:web": "pnpm --filter web build",
    "build:studio": "pnpm --filter studio build",
    "preview": "pnpm --filter web preview",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": ["alchemy", "astro", "sanity", "monorepo"],
  "author": "Alchemy Digital Solutions",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  }
}