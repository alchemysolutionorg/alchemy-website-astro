# Sanity Project Configuration
# Get these from your Sanity project dashboard: https://www.sanity.io/manage

# Your Sanity Project ID
SANITY_PROJECT_ID=your-project-id

# Your Dataset Name (usually 'production' or 'development')
SANITY_DATASET=production

# API Token (optional - for builds and previews)
# Generate at: https://www.sanity.io/manage/project/<project-id>/api#tokens
# SANITY_API_TOKEN=your-api-token